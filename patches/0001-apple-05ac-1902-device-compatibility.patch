-                        pEcmFunctionalDescr = (PUSB_ECM_CS_NET_FUNCTIONAL_DESCRIPTOR) pCsFuncDescriptor;
+                        if (!m_IsAppleNcm1902 || pEcmFunctionalDescr == nullptr)
