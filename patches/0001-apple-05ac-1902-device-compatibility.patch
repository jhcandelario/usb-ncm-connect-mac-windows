+                            pEcmFunctionalDescr = (PUSB_ECM_CS_NET_FUNCTIONAL_DESCRIPTOR) pCsFuncDescriptor;
+                        }
 
                         break;
                     }
@@ -457,17 +488,39 @@ UsbNcmHostDevice::SelectConfiguration(
         STATUS_DEVICE_HARDWARE_ERROR,
         "Bad UsbNcm interfaces");
 
-    // select configuration with both interfaces to default setting 0
+    // Select the configuration with both interfaces at default setting 0.
+    // Apple 05AC:1902 has two NCM functions but no IADs, so when this driver
+    // owns the composite parent, every exposed interface must participate in
+    // the configuration selection. Otherwise USB/WDF rejects the partial
+    // request with STATUS_INVALID_PARAMETER.
     WDF_USB_DEVICE_SELECT_CONFIG_PARAMS configParams;
-    WDF_USB_INTERFACE_SETTING_PAIR settingPair[2] =
+    WDF_USB_INTERFACE_SETTING_PAIR settingPair[4] =
     {
         {m_ControlInterface, 0},
-        {m_DataInterface , 0}
+        {m_DataInterface , 0},
     };
+    UCHAR settingPairCount = 2;
+
+    if (m_IsAppleNcm1902)
+    {
+        NCM_RETURN_NT_STATUS_IF_FALSE_MSG(
+            numInterfaces <= ARRAYSIZE(settingPair),
+            STATUS_DEVICE_HARDWARE_ERROR,
+            "Unexpected Apple USB interface count");
+
+        settingPairCount = numInterfaces;
+        for (UCHAR ifIndex = 0; ifIndex < numInterfaces; ifIndex++)
+        {
+            settingPair[ifIndex].UsbInterface = WdfUsbTargetDeviceGetInterface(
+                m_WdfUsbTargetDevice,
+                ifIndex);
+            settingPair[ifIndex].SettingIndex = 0;
+        }
+    }
 
     WDF_USB_DEVICE_SELECT_CONFIG_PARAMS_INIT_MULTIPLE_INTERFACES(
         &configParams,
-        ARRAYSIZE(settingPair),
+        settingPairCount,
         settingPair);
 
     NCM_RETURN_IF_NOT_NT_SUCCESS_MSG(
@@ -613,11 +666,22 @@ UsbNcmHostDevice::RetrieveInterruptPipe(
 {
     PAGED_CODE();
 
+    UCHAR pipeCount = WdfUsbInterfaceGetNumConfiguredPipes(m_ControlInterface);
+
+    if (m_IsAppleNcm1902 && pipeCount == 0)
+    {
+        // Apple reports link state out of band and has no CDC notification
+        // endpoint. The bulk interface is still a usable NCM data channel.
+        m_ControlInterruptPipe = nullptr;
+        m_ControlInterruptPipeMaxPacket = 0;
+        return STATUS_SUCCESS;
+    }
+
     WDF_USB_PIPE_INFORMATION pipeInfo;
     WDF_USB_PIPE_INFORMATION_INIT(&pipeInfo);
 
     NCM_RETURN_NT_STATUS_IF_FALSE_MSG(
-        WdfUsbInterfaceGetNumConfiguredPipes(m_ControlInterface) == 1,
+        pipeCount == 1,
         STATUS_DEVICE_HARDWARE_ERROR,
         "Bad NCM control interface");
 
@@ -745,7 +809,23 @@ UsbNcmHostDevice::EnterWorkingState(
         NCM_RETURN_IF_NOT_NT_SUCCESS(RetrieveDataBulkPipes());
     }
 
-    NCM_RETURN_IF_NOT_NT_SUCCESS(StartPipe(m_ControlInterruptPipe));
+    if (m_ControlInterruptPipe != nullptr)
+    {
+        NCM_RETURN_IF_NOT_NT_SUCCESS(StartPipe(m_ControlInterruptPipe));
+    }
+    else if (m_IsAppleNcm1902)
+    {
+        // Without a notification endpoint Windows will never receive the
+        // standard NETWORK_CONNECTION or CONNECTION_SPEED_CHANGE messages.
+        // Selecting data alternate setting 1 above is our carrier-up event.
+        m_NcmAdapterCallbacks->EvtUsbNcmAdapterSetLinkSpeed(
+            m_NetAdapter,
+            APPLE_NCM_LINK_SPEED_BPS,
+            APPLE_NCM_LINK_SPEED_BPS);
+        m_NcmAdapterCallbacks->EvtUsbNcmAdapterSetLinkState(
+            m_NetAdapter,
+            TRUE);
+    }
 
     return STATUS_SUCCESS;
 }
@@ -757,7 +837,16 @@ UsbNcmHostDevice::LeaveWorkingState(
     void
 )
 {
-    StopPipe(m_ControlInterruptPipe);
+    if (m_ControlInterruptPipe != nullptr)
+    {
+        StopPipe(m_ControlInterruptPipe);
+    }
+    else if (m_IsAppleNcm1902)
+    {
+        m_NcmAdapterCallbacks->EvtUsbNcmAdapterSetLinkState(
+            m_NetAdapter,
+            FALSE);
+    }
     return STATUS_SUCCESS;
 }
 
